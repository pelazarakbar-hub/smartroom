# Contoh pengaturan untuk server publik. Salin isinya ke file .env DI SERVER (jangan di-commit ke GitHub).
APP_NAME=SmartRoom
APP_ENV=production
APP_DEBUG=false
APP_URL=https://alamat-websitemu.com
# APP_KEY dibuat dengan: php artisan key:generate

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database
DB_USERNAME=user_database
DB_PASSWORD=password_database_yang_kuat

SESSION_SECURE_COOKIE=true
LOG_LEVEL=warning

# Akun awal. Isi password kuat; seeder tidak membuat akun contoh di production bila kosong.
SEED_ADMIN_EMAIL=emailkamu@contoh.com
SEED_ADMIN_PASSWORD=
